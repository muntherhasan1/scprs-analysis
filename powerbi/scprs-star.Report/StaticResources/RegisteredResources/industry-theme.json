{
  "name": "Industry — SCPRS",
  "background": "#F2F2F3",
  "foreground": "#1D1F20",
  "tableAccent": "#5980A6",
  "dataColors": ["#1D2D3D", "#2C455D", "#416180", "#5980A6", "#749DC4", "#94BCE3", "#B5D9FD", "#D6EBFF"],
  "good": "#416180",
  "neutral": "#7A7A7D",
  "bad": "#2B2B2D",
  "textClasses": {
    "title": { "fontFace": "Barlow Condensed", "fontSize": 13, "color": "#1D1F20" },
    "header": { "fontFace": "Barlow Condensed", "fontSize": 11, "color": "#5D5D60" },
    "label": { "fontFace": "Barlow", "fontSize": 9, "color": "#1D1F20" },
    "callout": { "fontFace": "Barlow Condensed", "fontSize": 30, "color": "#1D1F20" },
    "largeTitle": { "fontFace": "Barlow Condensed", "fontSize": 22, "color": "#1D1F20" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1D1F2029" } }, "radius": 0 }],
        "visualHeader": [{ "show": false }],
        "title": [{ "show": true, "fontFamily": "Barlow Condensed", "fontSize": 13,
          "fontColor": { "solid": { "color": "#1D1F20" } },
          "background": { "solid": { "color": "#00000000" } }, "alignment": "left" }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#5D5D60" } },
          "fontFamily": "Barlow", "fontSize": 9, "showAxisTitle": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#D6D6D8" } }, "gridlineThickness": 1,
          "labelColor": { "solid": { "color": "#5D5D60" } },
          "fontFamily": "Barlow", "fontSize": 9, "showAxisTitle": false }],
        "legend": [{ "show": false }],
        "labels": [{ "fontFamily": "Barlow", "fontSize": 9,
          "color": { "solid": { "color": "#1D1F20" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F2F2F3" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F2F2F3" } }, "transparency": 0 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1D1F2029" } }, "radius": 0 }],
        "header": [{ "fontFamily": "Barlow Condensed", "fontSize": 11,
          "fontColor": { "solid": { "color": "#5D5D60" } } }],
        "items": [{ "fontFamily": "Barlow", "fontSize": 10,
          "fontColor": { "solid": { "color": "#1D1F20" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E4E4E6" } },
          "rowPadding": 3, "outlineColor": { "solid": { "color": "#1D1F20" } } }],
        "columnHeaders": [{ "fontFamily": "Barlow Condensed", "fontSize": 11,
          "fontColor": { "solid": { "color": "#1D1F20" } },
          "backColor": { "solid": { "color": "#00000000" } },
          "outline": "BottomOnly" }],
        "values": [{ "fontFamily": "Barlow", "fontSize": 10,
          "backColor": { "solid": { "color": "#00000000" } },
          "backColorSecondary": { "solid": { "color": "#00000000" } } }]
      }
    },
    "card": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#1D1F2029" } }, "radius": 0 }],
        "labels": [{ "fontFamily": "Barlow Condensed", "fontSize": 30,
          "color": { "solid": { "color": "#1D1F20" } } }],
        "categoryLabels": [{ "fontFamily": "Barlow Condensed", "fontSize": 10,
          "color": { "solid": { "color": "#5D5D60" } } }]
      }
    }
  }
}
